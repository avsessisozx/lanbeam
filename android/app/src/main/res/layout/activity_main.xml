<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/self_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="Alıma hazır · aynı ağdaki cihazlar seni görebilir"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- What to send -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Section"
                android:text="Gönderilecekler" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/pick_files"
                    style="@style/BtnTonal"
                    android:text="📄  Dosya seç" />

                <Button
                    android:id="@+id/pick_folder"
                    style="@style/BtnTonal"
                    android:text="📁  Klasör seç" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/selection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/clear_selection"
                    style="@style/BtnText"
                    android:text="Temizle" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nearby devices -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Yakındaki cihazlar" />

                <Button
                    android:id="@+id/refresh"
                    style="@style/BtnText"
                    android:text="⟳  Yenile" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/peers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/peers_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dashed"
                android:gravity="center"
                android:padding="18dp"
                android:text="Cihaz bulunamadı.\nDiğer cihazda LanBeam açık ve aynı Wi-Fi/modemde olmalı."
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Other ways -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Section"
                android:text="Diğer yollar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/show_qr"
                    style="@style/BtnTonal"
                    android:text="▦  QR / bağlantı" />

                <Button
                    android:id="@+id/hotspot"
                    style="@style/BtnTonal"
                    android:text="📶  Router olmadan" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/scan"
                    style="@style/BtnTonal"
                    android:text="📷  QR tara (al)" />

                <Button
                    android:id="@+id/from_link"
                    style="@style/BtnTonal"
                    android:text="🔗  Bağlantıdan al" />
            </LinearLayout>
        </LinearLayout>

        <!-- Transfers -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Aktarımlar" />

                <Button
                    android:id="@+id/clear_transfers"
                    style="@style/BtnText"
                    android:text="Bitenleri temizle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transfers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/transfers_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="Henüz aktarım yok."
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Link and report -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Section"
                android:layout_width="match_parent"
                android:text="Bağlantı ve rapor" />

            <TextView
                android:id="@+id/link_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="…"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/link_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <Button
                    android:id="@+id/speed_test"
                    style="@style/BtnTonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="⚡  Hız testi" />

                <Button
                    android:id="@+id/report"
                    style="@style/BtnTonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📋  Rapor / Geri bildirim" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
