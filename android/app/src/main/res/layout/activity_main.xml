<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/self_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:textColor="#F2FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:text="Alıma hazır · aynı ağdaki cihazlar seni görebilir"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- What to send -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Section"
                android:drawableStart="@drawable/ic_upload_accent"
                android:text="Gönderilecekler" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/pick_files"
                    style="@style/BtnTonal"
                    android:drawableStart="@drawable/ic_file_add"
                    android:text="Dosya seç" />

                <Button
                    android:id="@+id/pick_folder"
                    style="@style/BtnTonal"
                    android:drawableStart="@drawable/ic_folder_add"
                    android:text="Klasör seç" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/selection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/clear_selection"
                    style="@style/BtnText"
                    android:text="Temizle" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nearby devices -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_devices_accent"
                    android:text="Yakındaki cihazlar" />

                <Button
                    android:id="@+id/refresh"
                    style="@style/BtnText"
                    android:drawableStart="@drawable/ic_refresh_accent"
                    android:text="Yenile" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/peers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/peers_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dashed"
                android:gravity="center"
                android:padding="18dp"
                android:text="Cihaz bulunamadı.\nDiğer cihazda LanBeam açık ve aynı Wi-Fi/modemde olmalı."
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Other ways -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Section"
                android:drawableStart="@drawable/ic_link_accent"
                android:text="Diğer yollar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/show_qr"
                    style="@style/BtnTonal"
                    android:drawableStart="@drawable/ic_qr"
                    android:text="QR / bağlantı" />

                <Button
                    android:id="@+id/hotspot"
                    style="@style/BtnTonal"
                    android:drawableStart="@drawable/ic_wifi"
                    android:text="Router olmadan" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/scan"
                    style="@style/BtnTonal"
                    android:drawableStart="@drawable/ic_scan"
                    android:text="QR tara (al)" />

                <Button
                    android:id="@+id/from_link"
                    style="@style/BtnTonal"
                    android:drawableStart="@drawable/ic_link"
                    android:text="Bağlantıdan al" />
            </LinearLayout>
        </LinearLayout>

        <!-- Transfers -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_speed_accent"
                    android:text="Aktarımlar" />

                <Button
                    android:id="@+id/clear_transfers"
                    style="@style/BtnText"
                    android:text="Bitenleri temizle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transfers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/transfers_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="Henüz aktarım yok."
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Link and report -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Section"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_report_accent"
                android:text="Bağlantı ve rapor" />

            <TextView
                android:id="@+id/link_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="…"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/link_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <Button
                    android:id="@+id/speed_test"
                    style="@style/BtnTonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_speed"
                    android:text="Hız testi" />

                <Button
                    android:id="@+id/report"
                    style="@style/BtnTonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_report"
                    android:text="Rapor / Geri bildirim" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
